# /etc/catchlogx-backup.env - example. The real file lives on the host only.
#
# Installed as /etc/catchlogx-backup.env, mode 600 root:root. systemd reads it
# as root before dropping to User=clxadmin, so the credentials never need to be
# readable by the backup user. This example is the documentation of the knobs -
# it contains no secret.
#
# Everything here is optional except MAIL_TO/BACKUP_AGE_RECIPIENT/OFFSITE_* if
# you want mail, encrypted env and off-site copies. Missing values degrade to
# "local backup only" and are reported by `catchlogx-backup status`.

# Where the sets live. Kept inside the backup user's home, matching the sets
# created by the one-off maintenance jobs.
BACKUP_ROOT=/home/clxadmin/catchlogx-backups

# Retention. Sets from the 1st of a month are never rotated away while fewer
# than KEEP_MONTHLY of them exist. Sets created by hand (cutover-*, pre-apt-*)
# are never touched.
KEEP_DAILY=7
KEEP_MONTHLY=3

# The runtime env of the app: the only copy of DATABASE_URL, NEXTAUTH_SECRET and
# READONLY_DB_PASSWORD. Backed up encrypted, never in clear text.
APP_ENV_FILE=/home/clxadmin/.config/catchlogx/.env

# age recipient (public key). The matching private key must NOT be on this
# host - see README.md, "Key ceremony". This still encrypts env.age; the
# database archive itself travels in clear text since #192.
BACKUP_AGE_RECIPIENT=

# Off-site push (#192): knock + rsync over SSH to the dev VPS, as the
# unprivileged user `catchlogx` (directory ~/backups there). The archive is a
# plain tar.zst; only env.age inside it is encrypted.
OFFSITE_HOST=
OFFSITE_USER=catchlogx
# Only used by `status` (rsync writes into the forced rrsync directory).
OFFSITE_DIR=/home/catchlogx/backups
# Key created with `ssh-keygen -t ed25519 -N '' -f /home/clxadmin/.ssh/catchlogx-offsite`.
OFFSITE_SSH_KEY=/home/clxadmin/.ssh/catchlogx-offsite
# PORT-KNOCKING SEQUENCE - a secret, get it from Georg (#189). Space-separated
# TCP ports, in the order the daemon expects: 1234 5678 9012
OFFSITE_KNOCK_PORTS=

# Notification. The reports go to a LOCAL mailbox by default: they are delivered
# by the local postfix into /var/mail/root and read with `mail -u root`. Nothing
# has to be fetched from an external mailbox, and no SMTP account is needed for
# the reports. Set MAIL_TO to an address only when a monitored mailbox exists.
# MAIL_FROM is then the sender and must be the SMTP account's own address.
MAIL_TO=root@localhost
# Optional second recipient: one message, delivered twice (local mailbox +
# the BOKU mailbox, which postfix relays out). Empty = local only.
MAIL_COPY_TO=
MAIL_FROM=
