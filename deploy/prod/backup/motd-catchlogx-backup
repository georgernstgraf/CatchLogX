#!/bin/sh
# Shows the age of the newest production backup at SSH login.
#
# Deliberately ugly-on-purpose: it is the cheapest way to notice "the backup
# timer has been failing for a week" while the mail chain is still young. With
# a working MAIL_TO this file is a backup channel, not the primary one.
#
# Installed as /etc/update-motd.d/95-catchlogx-backup, mode 755 root:root.

BACKUP_ROOT=/home/clxadmin/catchlogx-backups

[ -d "$BACKUP_ROOT" ] || exit 0

newest=$(find "$BACKUP_ROOT" -mindepth 1 -maxdepth 1 -type d -name '20*' \
  -exec test -s '{}/db.dump' \; -printf '%T@ %f\n' 2>/dev/null \
  | sort -rn | head -n1)

if [ -z "$newest" ]; then
  printf '\n  \033[1;31mCatchLogX: keine Sicherung vorhanden\033[0m (%s)\n\n' "$BACKUP_ROOT"
  exit 0
fi

stamp=$(echo "$newest" | cut -d' ' -f2-)
age=$(( ( $(date +%s) - $(echo "$newest" | cut -d' ' -f1 | cut -d. -f1) ) / 3600 ))

if [ "$age" -le 26 ]; then
  printf '\n  CatchLogX-Backup: %s (%s h alt)\n\n' "$stamp" "$age"
else
  printf '\n  \033[1;31mCatchLogX-Backup: %s ist %s h alt - Timer prüfen\033[0m\n' "$stamp" "$age"
  printf '  systemctl list-timers catchlogx-backup*\n\n'
fi
