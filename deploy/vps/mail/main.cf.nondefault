# `postconf -n` on claw, 2026-11-10 (non-default settings only, #193).
# Package defaults that are only paths (command_directory, queue_directory, …)
# and the untouched example lines (debug_peer_level, debugger_command,
# smtpd_banner) are omitted. See README.md for the commands that produce this.
alias_database = hash:/etc/aliases
alias_maps = hash:/etc/aliases
compatibility_level = 3.6
disable_vrfy_command = yes
inet_interfaces = loopback-only
inet_protocols = ipv4
message_size_limit = 26214400
milter_default_action = accept
milter_protocol = 6
mydestination = $myhostname, localhost
mydomain = graf.priv.at
myhostname = claw.graf.priv.at
mynetworks = 127.0.0.0/8
myorigin = catchlogx.graf.priv.at
non_smtpd_milters = inet:127.0.0.1:8891
relayhost =
smtp_tls_CApath = /etc/ssl/certs
smtp_tls_loglevel = 1
smtp_tls_security_level = may
smtpd_helo_required = yes
smtpd_milters = inet:127.0.0.1:8891
smtpd_recipient_restrictions = permit_mynetworks, reject_unauth_destination
