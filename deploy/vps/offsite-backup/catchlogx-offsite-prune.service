# User unit: install as ~catchlogx/.config/systemd/user/catchlogx-offsite-prune.service
# (`systemctl --user daemon-reload` as catchlogx). It needs no privileges since
# #192 - the archives live in the same user's home and belong to it.
[Unit]
Description=Rotate and verify off-site CatchLogX backups
Documentation=https://github.com/georgernstgraf/CatchLogX/tree/dev/deploy/vps/offsite-backup

[Service]
Type=oneshot
ExecStart=%h/catchlogx-offsite-prune.sh
Nice=10
IOSchedulingClass=best-effort
