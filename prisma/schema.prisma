// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRoles {
  SUPER_ADMIN
  ADMIN
  VIEWER
}

model User {
  id             String        @id @default(cuid())
  username       String        @unique
  hashedPassword String
  name           String?
  email          String        @unique
  role           UserRoles     @default(VIEWER)
  isActive       Boolean       @default(true)
  isFirstLogin   Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sessions       Session[]
  imports        Imports[]     @relation("ImportOwner")
  userQueries    UserQueries[]
  queryLogs      QueryLog[]
}

model UserQueries {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  userId    String
  query     String
  name      String

  // relations
  user User @relation(fields: [userId], references: [id])
}

// Audit log of every query run through the SQL query UI (#121).
model QueryLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  userId     String
  query      String
  success    Boolean
  error      String?
  rowCount   Int?
  durationMs Int

  // relations
  user User @relation(fields: [userId], references: [id])
}

model TemplateFiles {
  id               String    @id @default(uuid())
  fileName         String
  blobId           String
  uploadedByUserId String
  createdAt        DateTime  @default(now())
  isVisible        Boolean   @default(true)
  isDeleted        Boolean?
  deletedAt        DateTime?

  // relations
  blob FileBlob @relation(fields: [blobId], references: [id])
}

// File contents live in PostgreSQL instead of MinIO (#131). A blob is written
// together with the row that references it, inside one transaction.
model FileBlob {
  id        String   @id @default(cuid())
  fileName  String
  mimeType  String
  sizeBytes Int
  data      Bytes
  createdAt DateTime @default(now())

  // relations
  imports       Imports[]
  templateFiles TemplateFiles[]
}

model PasswordResets {
  id                String              @id @default(cuid())
  username          String
  token             String              @unique
  timestamp         DateTime
  state             PasswordResetStates
  passwordChangedAt DateTime?
}

// One imported Excel file (#202). The row is the provenance of every sampling
// it created. Deleting an import removes the row itself — there is no
// tombstone (#184, decided 2026-11-15): the fingerprint lives in the data repo
// and the deletion is logged to the journal.
model Imports {
  id              String    @id @default(cuid())
  batchId         String
  userId          String
  fileName        String
  fileHash        String // sha256 of the received bytes, duplicate guard
  rowCount        Int
  blobId          String? // the original file
  createdAt       DateTime  @default(now())

  // relations
  user      User       @relation("ImportOwner", fields: [userId], references: [id])
  blob      FileBlob?  @relation(fields: [blobId], references: [id], onDelete: Restrict)
  samplings Sampling[]

  @@index([userId, createdAt])
  @@index([fileHash])
}

enum PasswordResetStates {
  REQUESTED
  EXPIRED
  DONE
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RiverSite {
  id             Int     @id @default(autoincrement())
  siteCode       String  @unique
  riverName      String
  siteName       String?
  landmarkUp     String? // bridge, powerline …
  latitude       Float?
  longitude      Float?
  landmarkDown   String?
  latDown        Float?
  longDown       Float?
  localityLength Float? // m
  localityWidth  Float? // m

  // relations
  samplings Sampling[]

  @@map("river_sites")
}

model Sampling {
  id     Int       @id @default(autoincrement())
  siteId Int
  site   RiverSite @relation(fields: [siteId], references: [id])

  // Every sampling comes from exactly one import (#202). Restrict is
  // deliberate: a stray DELETE on Imports must fail loudly, deletion happens
  // explicitly in the service.
  importId String
  import   Imports @relation(fields: [importId], references: [id], onDelete: Restrict)

  year                      Int
  catchDate                 DateTime?
  dataProvider              String? // "Michael Grohmann", etc.
  askProviderBeforeUse      Boolean? // yes / no
  source                    String? // IHG, etc.
  project                   String? // DB, etc.
  fishingAuthority          String?
  preclassificationStressor String?
  temp                      Float? // °C
  conductivity              Float? // µS cm-1
  pHValue                   Float?
  oCont                     Float? // mg l-1
  oSat                      Float? // %
  method                    String? // Boat / Wading …
  assessment                String? // strip / point …
  samplingStrategy          String? // partialprop …
  anodes                    Int?
  numSubsections            Int?
  lengthSubsection          Float? // m
  widthSubsection           Float? // m
  typeOfStrip               String?
  habitat                   String? // Ufer, Tief, …
  runStrip                  String? // Flach, Pool …
  catchEfficiency           Float? // %
  remarksRawData            String?
  remarkImport              String?

  // relations
  catches FishCatch[]

  // `deleteImport` and the import list filter by importId (#202).
  @@index([importId])
  @@map("samplings")
}

model FishCatch {
  id            Int         @id @default(autoincrement())
  samplingId    Int
  sampling      Sampling    @relation(fields: [samplingId], references: [id])
  // excel erst ab/unterhalb von hier!!!
  fishId        String? // WAS IS DAS? Wir brauchen die nicht (weil wir eh id haben)
  species       FishSpecies @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  speciesId     Int
  lengthMm      Int?
  totalWeightGr Float?
  pitDec        String?
  pitHex        String?
  recapture     Boolean     @default(false)
  createdAt     DateTime    @default(now())

  // PIT lookups are per-tag (recapture detection, #184); without this index
  // they are sequential scans over the whole catch table.
  @@index([pitDec])
  @@map("fish_catches")
}

model FishSpecies {
  id          Int     @id @default(autoincrement())
  speciesName String  @unique
  germanName  String?
  family      String?

  // relations
  catches FishCatch[]

  @@map("fish_species")
}
