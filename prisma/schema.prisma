// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
    output   = "../app/generated/prisma"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  username       String   @unique
  hashedPassword String
  name           String?
  email          String   @unique
  role           String   @default("viewer")
  isFirstLogin   Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sessions       Session[]
  uploads        Uploads[]
  userQueries    UserQueries[]
}

model UserQueries {
    id          String    @id @default(uuid())
    createdAt   DateTime  @default(now())
    updatedAt   DateTime? @updatedAt
    userId      String
    query       String
    name        String

    // relations
    user        User      @relation(fields: [userId], references: [id])
}

model DummyFiles {
    id                  String    @id @default(uuid())
    fileName            String
    filePath            String
    uploadedByUserId    String
    createdAt           DateTime    @default(now())
    isVisible           Boolean     @default(true)
    isDeleted           Boolean?
    deletedAt           DateTime?
}

model PasswordResets {
  id                String      @id @default(cuid())
  username          String
  token             String      @unique
  timestamp         DateTime
  state             PasswordResetStates
  passwordChangedAt DateTime?
}

model Uploads {
    id              String      @id @default(cuid())
    uploaded_by     String
    link            String
    state           UploadStates
    note            String?     
    createdAt       DateTime    @default(now())
    updatedAt       DateTime    @updatedAt

    user            User        @relation(fields: [uploaded_by], references: [id])
}

enum UploadStates {
    UPLOADED
    ACCEPTED
    REJECTED
    DB_ERROR
    SAVED_IN_DB
}

enum PasswordResetStates {
    REQUESTED
    EXPIRED
    DONE
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RiverSite {
    id             Int     @id @default(autoincrement())
    siteCode       String  @unique
    riverName      String
    siteName       String?
    landmarkUp     String? // bridge, powerline …
    latitude       Float?
    longitude      Float?
    landmarkDown   String?
    latDown        Float?
    longDown       Float?
    localityLength Float? // m
    localityWidth  Float? // m

    // relations
    samplings Sampling[]

    @@map("river_sites")
}

model Sampling {
    id     Int       @id @default(autoincrement())
    siteId Int
    site   RiverSite @relation(fields: [siteId], references: [id])

    year                      Int
    catchDate                 DateTime?
    dataProvider              String? // "Michael Grohmann", etc.
    askProviderBeforeUse      Boolean? // yes / no
    source                    String? // IHG, etc.
    project                   String? // DB, etc.
    fishingAuthority          String?
    preclassificationStressor String?
    temp                      Float? // °C
    conductivity              Float? // µS cm-1
    pHValue                   Float?
    oCont                     Float? // mg l-1
    oSat                      Float? // %
    method                    String? // Boat / Wading …
    assessment                String? // strip / point …
    samplingStrategy          String? // partialprop …
    anodes                    Int?
    numSubsections            Int?
    lengthSubsection          Float? // m
    widthSubsection           Float? // m
    typeOfStrip               String?
    habitat                   String? // Ufer, Tief, …
    runStrip                  String? // Flach, Pool …
    catchEfficiency           Float? // %
    remarksRawData            String?
    remarkImport              String?

    // relations
    catches FishCatch[]

    @@map("samplings")
}

model FishCatch {
    id            Int         @id @default(autoincrement())
    samplingId    Int
    sampling      Sampling    @relation(fields: [samplingId], references: [id])
    // excel erst ab/unterhalb von hier!!!
    fishId        String? // WAS IS DAS? Wir brauchen die nicht (weil wir eh id haben)
    species       FishSpecies @relation(fields: [speciesId], references: [id])
    speciesId     Int
    lengthMm      Int?
    totalWeightGr Float?

    @@map("fish_catches")
}

model FishSpecies {
    id          Int     @id @default(autoincrement())
    speciesName String  @unique
    germanName  String?
    latinName   String?
    family      String?

    // relations
    catches FishCatch[]

    @@map("fish_species")
}
